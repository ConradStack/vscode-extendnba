{
  "name": "extendnba",
  "displayName": "extendnba",
  "description": "Additional indicators for Non-basic ASCII",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extendnba.helloWorld",
        "title": "Hello World"
      }
    ],
    "configuration": {
      "title": "extendnba",
      "properties": {
        "extendnba.ignorePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git/**"
          ],
          "description": "Glob patterns for files/paths that should be ignored by the non-basic ASCII gutter indicator and Problems panel diagnostic. Patterns are matched against both the workspace-relative path and the absolute file path (e.g. \"**/.git/**\", \"**/*.min.js\")."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "vsce package",
    "clean": "rm -rf dist",
    "distclean": "rm -rf dist node_modules"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "0.28.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "keytar@7.9.0": true,
    "@vscode/vsce-sign@2.0.9": true
  },
  "dependencies": {
    "minimatch": "^10.2.6"
  }
}
